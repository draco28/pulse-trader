# PulseTrader — config template (SAFE to commit; contains NO real secrets).
#
# Setup:
#   1. cp .env.example .env          # .env is gitignored
#   2. fill GLM_API_KEY in .env with your real key, AND/OR seed the Keychain:
#        security add-generic-password -s PulseTrader -a glm_api_key -w '<your-key>'
#      (the production/demo read path is the macOS Keychain, per NFR-5)
#
# GLM via the Z.AI coding plan — OpenAI-compatible API, consumed through
# pulsehive-openai's OpenAICompatibleProvider. GLM_BASE_URL + GLM_MODEL_ID are
# config (not secrets); GLM_API_KEY is the secret (Keychain in production).
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL_ID=glm-5.2
GLM_API_KEY=your-glm-api-key-here
