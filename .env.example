# PulseTrader — config reference (SAFE to commit; contains NO real secrets).
#
# HOW VS-1.3.1 ACTUALLY READS CONFIG — read this before trying to "seed" a key:
#   * GLM_BASE_URL + GLM_MODEL_ID below are COMPILED-IN constants this slice
#     (src/adapters/llm/glm.rs). The values here only MIRROR them for reference —
#     the binary does NOT read this file for them.
#   * The GLM API key is read ONLY from the macOS *data-protection* Keychain via
#     `keyring` (src/adapters/secrets.rs, FR-1/NFR-5). `pulse llm-check` does NOT
#     load `.env`, and `security add-generic-password` writes the *login* keychain,
#     which `keyring` cannot see — so neither GLM_API_KEY here nor that CLI command
#     makes the key readable by this binary.
#   * The supported key-seed path lands in VS-1.3.4 (`pulse setup-keys`), which
#     writes the data-protection Keychain entry under this binary's own code
#     identity. Until then, live transport is exercised by injecting the key
#     in-process (see the slice retrospective).
#
# GLM via the Z.AI coding plan — OpenAI-compatible API, consumed through
# pulsehive-openai's OpenAICompatibleProvider.
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL_ID=glm-5.2
# Placeholder only — NOT read by the VS-1.3.1 CLI (see above). The real key is
# seeded into the Keychain via `pulse setup-keys` in VS-1.3.4.
GLM_API_KEY=your-glm-api-key-here
